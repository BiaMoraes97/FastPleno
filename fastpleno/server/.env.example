# Copie este arquivo para ".env" e preencha os valores.
PORT=3001

# Segredo usado para assinar os logins (JWT). Troque por um texto longo e aleatório.
JWT_SECRET=troque-este-segredo

# Código que a direção digita no cadastro para ganhar perfil de DIREÇÃO.
DIRECTION_CODE=FASTPLENO-DIRECAO-2026

# Chave da API Gemini e modelo usado na formatação.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# true = não chama a IA e gera uma prova de exemplo (bom para testar a interface).
MOCK_AI=false

# true = cria as contas de demonstração (professor@fastpleno.demo / direcao@fastpleno.demo, senha demo123).
# Coloque false quando for usar de verdade.
ENABLE_DEMO=true
